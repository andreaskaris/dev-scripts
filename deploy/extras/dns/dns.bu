variant: openshift
version: 4.20.0
metadata:
  name: 02-dns-hack
  labels:
    machineconfiguration.openshift.io/role: master
systemd:
  units:
  - name: on-prem-resolv-prepender.service
    mask: true
    enabled: false
  - name: create-resolv-prepender-done.service
    enabled: true
    contents: |
      [Unit]
      Description=Create resolv-prepender sentinel file
      Before=kubelet.service
      [Service]
      Type=oneshot
      ExecStart=/usr/bin/touch /run/resolv-prepender-kni-conf-done
      RemainAfterExit=true
      [Install]
      WantedBy=multi-user.target
storage:
  files:
  - path: /etc/resolv.conf
    mode: 0644
    overwrite: false
    contents:
      inline: |
        nameserver 10.100.0.1
  - path: /etc/NetworkManager/conf.d/dns-servers.conf
    mode: 0644
    overwrite: false
    contents:
      inline: |
        [global-dns-domain-*]
        servers=10.100.0.1

  - path: /etc/NetworkManager/conf.d/90-dns-none.conf
    mode: 0644
    overwrite: false
    contents:
      inline: |
        [main]
        dns=none
