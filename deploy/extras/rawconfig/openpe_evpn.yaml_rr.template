# OpenPERouter FRR Configuration Template — EVPN Route Reflector (ISIS + SRv6)
# Rendered by generate-config.sh using envsubst
#
# This node acts as the EVPN/VPN route reflector for all other PEs.
#
# Variables:
#   ${NODE_NAME}, ${UNDERLAY_NIC}, ${BGP_AS}, ${ROUTER_ID}
#   ${LOOPBACK_V6}, ${SRV6_SOURCE}, ${SRV6_PREFIX}, ${ISIS_NET}
#   ${VRF_NAME}, ${BR0_IP}, ${BR0_IP_V6}
#   ${EVPN_CLIENT_1}         - First client PE IPv6 loopback
#   ${EVPN_CLIENT_2}         - Second client PE IPv6 loopback
#   ${EXTERNAL_PEER_LOOPBACK} - External FRR (remotepe) IPv6 loopback

rawfrrconfigs:
  - priority: 100
    rawConfig: |
      frr version 10.5
      frr defaults traditional
      hostname ${NODE_NAME}
      log file /etc/frr/frr.log informational
      !
      interface ${UNDERLAY_NIC}
       ip router isis PE
       ipv6 router isis PE
      exit
      !
      interface lo
       ip router isis PE
       ipv6 router isis PE
      exit
      !
      router bgp ${BGP_AS}
       bgp router-id ${ROUTER_ID}
       no bgp ebgp-requires-policy
       no bgp default ipv4-unicast
       no bgp network import-check
       bgp log-neighbor-changes
       !
       neighbor EVPN-CLIENTS peer-group
       neighbor EVPN-CLIENTS remote-as ${BGP_AS}
       neighbor EVPN-CLIENTS update-source ${LOOPBACK_V6}
       neighbor ${EVPN_CLIENT_1} peer-group EVPN-CLIENTS
       neighbor ${EVPN_CLIENT_2} peer-group EVPN-CLIENTS
       neighbor ${EXTERNAL_PEER_LOOPBACK} peer-group EVPN-CLIENTS
       !
       segment-routing srv6
        locator MAIN
       exit
       !
       address-family ipv4 vpn
        neighbor EVPN-CLIENTS activate
        neighbor EVPN-CLIENTS route-reflector-client
       exit-address-family
       !
       address-family ipv6 vpn
        neighbor EVPN-CLIENTS activate
        neighbor EVPN-CLIENTS route-reflector-client
       exit-address-family
       !
       address-family l2vpn evpn
        neighbor EVPN-CLIENTS activate
        neighbor EVPN-CLIENTS route-reflector-client
        advertise-all-vni
        advertise-svi-ip
       exit-address-family
      exit
      !
      router bgp ${BGP_AS} vrf ${VRF_NAME}
       bgp router-id ${ROUTER_ID}
       no bgp ebgp-requires-policy
       no bgp default ipv4-unicast
       no bgp network import-check
       sid vpn per-vrf export auto
       !
       address-family ipv4 unicast
        network ${BR0_IP}/32
        rd vpn export ${ROUTER_ID}:2
        rt vpn both ${BGP_AS}:2
        export vpn
        import vpn
       exit-address-family
       !
       address-family ipv6 unicast
        network ${BR0_IP_V6}/128
        rd vpn export ${ROUTER_ID}:2
        rt vpn both ${BGP_AS}:2
        export vpn
        import vpn
       exit-address-family
       !
       address-family l2vpn evpn
        advertise ipv4 unicast
        advertise ipv6 unicast
       exit-address-family
      exit
      !
      router isis PE
       is-type level-1
       net ${ISIS_NET}
       topology ipv6-unicast
       lsp-gen-interval 2
       log-adjacency-changes
       log-pdu-drops
       segment-routing on
       segment-routing srv6
        locator MAIN
       exit
      exit
      !
      segment-routing
       srv6
        encapsulation
         source-address ${SRV6_SOURCE}
        exit
        locators
         locator MAIN
          prefix ${SRV6_PREFIX} block-len 32 node-len 16 func-bits 16
          behavior usid
         exit
        exit
       exit
      exit
      !
      end
