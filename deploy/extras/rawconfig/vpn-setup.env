# OpenPERouter VPN Setup Environment Variables
# Defaults tuned for the dev-scripts environment
#
# Location on node: /etc/openperouter/vpn-setup.env

# ============================================================================
# Underlay Configuration (setup-underlay.service)
# ============================================================================

# Physical NIC to move into FRR namespace for underlay BGP connectivity
UNDERLAY_NIC=enp2s0

# Timeout (in seconds) to wait for FRR container to become ready
FRR_READY_TIMEOUT=60

# ============================================================================
# BGP Configuration (generate-config.service)
# ============================================================================

# External FRR (TOR) IP address — matches deploy/devscripts/externalfrr/
TOR_IP=192.168.111.1

# External FRR BGP AS number
TOR_AS=64512

# Local BGP AS number for this node
LOCAL_AS=64514

# ============================================================================
# VPN Configuration (generate-config.service)
# ============================================================================

# VRF name
VRF_NAME=red

# L3VPN VXLAN Network Identifier (VNI)
L3_VNI=100

# L2VPN VXLAN Network Identifier (VNI)
L2_VNI=210

# VXLAN UDP destination port
VXLAN_PORT=4789

# L2VPN gateway IP address (CIDR notation)
L2_GATEWAY_IP=192.168.110.1/24
